# Prefer monorepo root: copy ../../.env.example → ../../.env

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accounting

APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:3000"]

# Delegated RBAC (must match tenant-service TENANT_INTERNAL_API_TOKEN)
TENANT_INTERNAL_API_TOKEN=dev-internal-token-change-me
TENANT_SERVICE_URL=http://localhost:8002

# Match COA seed AR account (coa-service uses code 1200)
AR_CONTROL_ACCOUNT_CODE=1100
GST_OUTPUT_ACCOUNT_CODE=2100

# Local dev: uv run --package ar-ap-service uvicorn ar_ap_service.main:app --reload --port 8005
