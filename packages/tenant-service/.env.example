# Prefer monorepo root: copy ../../.env.example → ../../.env

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accounting

APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:3000"]

# Internal RBAC — must match ledger-service and coa-service (US-6 reads accounting:read)
TENANT_INTERNAL_API_TOKEN=dev-internal-token-change-me

DEFAULT_COA_SEED=true

# Local dev: uv run --package tenant-service uvicorn tenant_service.main:app --reload --port 8002
