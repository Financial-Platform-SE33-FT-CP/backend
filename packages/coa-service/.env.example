# COA service (account list for US-6 ledger UI; US-4 chart of accounts).
# Prefer the monorepo root file: copy ../../.env.example → ../../.env

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accounting

APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:3000"]

# Delegated RBAC (must match tenant-service TENANT_INTERNAL_API_TOKEN)
TENANT_INTERNAL_API_TOKEN=dev-internal-token-change-me
TENANT_SERVICE_URL=http://localhost:8002

# Local dev: uv run --package coa-service uvicorn coa_service.main:app --reload --port 8004
