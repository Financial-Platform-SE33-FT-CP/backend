# Ledger service (US-6 trial balance & account ledger; US-7 opening balance).
# Prefer the monorepo root file: copy ../../.env.example → ../../.env
# Settings load ../../.env automatically when you run uvicorn from the backend repo.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accounting

APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:3000"]

# Delegated RBAC (must match tenant-service TENANT_INTERNAL_API_TOKEN)
TENANT_INTERNAL_API_TOKEN=dev-internal-token-change-me
TENANT_SERVICE_URL=http://localhost:8002

# Local dev: uv run --package ledger-service uvicorn ledger_service.main:app --reload --port 8003
